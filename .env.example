# EvidentIA — environment template.
# Copy to .env to override; every variable already has a working default and
# `docker compose up --build` works without this file. Never commit real secrets.

# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_USER=evidentia
POSTGRES_PASSWORD=evidentia
POSTGRES_DB=evidentia

# ── LLM (Together.ai, OpenAI-compatible) ─────────────────────────────────
# Empty => generation endpoints answer with a structured abstention; the rest
# of the system keeps working on the local snapshot.
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
LLM_MODEL=zai-org/GLM-5.3

# ── Embeddings (local FastEmbed, no API key needed) ──────────────────────
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ── Data ─────────────────────────────────────────────────────────────────
# Public TVN RSS feed URL; empty => TVN fetcher skipped (GDELT still covers news).
TVN_RSS_URL=
# true => ingest from the frozen snapshot in data/seed (offline demo, T10).
USE_SEED_SNAPSHOT=false

# ── Notion sync (optional; scripts/sync_notion.py, Fase 7) ───────────────
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
